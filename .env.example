# Public site URL — used for canonical URLs, sitemap.xml, robots.txt, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://coorbitz.com

# The Contact page form submits directly to this Formspree endpoint from the browser.
# Formspree emails each submission to whatever address is configured on the Formspree
# form itself (set that in the Formspree dashboard, not here). Safe to expose publicly.
NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT=https://formspree.io/f/xpqvpkol

# SMTP credentials used by Nodemailer to send careers-form (job application) and
# newsletter-signup emails. For Gmail: enable 2-Step Verification on the account, then
# create an "App Password" at https://myaccount.google.com/apppasswords and use that
# (not your normal password) below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Where internal notification emails are sent. Defaults to info@coorbitz.com if unset.
# CONTACT_TO_EMAIL is used only for newsletter-signup notifications now that the Contact
# page form submits straight to Formspree above.
CONTACT_TO_EMAIL=info@coorbitz.com
CAREERS_TO_EMAIL=info@coorbitz.com

# --- Cloudflare Turnstile (optional bot protection on the Contact & Careers forms) ---
# Both forms work exactly as before if these are left unset. Get keys from the Cloudflare
# dashboard: Turnstile > Add site. The site key is public; the secret key must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics & tag integrations (all optional — each only loads if its ID is set) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# --- Search engine ownership verification (meta tag method) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
